# Copy this file to .env.local (already gitignored) and fill in what you need.
# Full reference: NEXT_HARNESS/ENVIRONMENT_VARIABLES.md — this pipeline reuses
# the exact same MCP connection the harness uses, since harness_agent_runs
# lives in the MCP server's own Postgres, not a database of this repo's own.

# ── MCP connection (required) — same endpoint NEXT_HARNESS points at ───────
MCP_ENDPOINT_URL=https://your-endpoint.execute-api.us-east-1.amazonaws.com/mcp
# Only if your API Gateway stage enforces auth:
# MCP_API_KEY=<api-gateway-key>          # sent as x-api-key
# MCP_AUTH_TOKEN=<token>                 # sent as Authorization: Bearer <token>

# ── Remediation (only needed for `npm run remediate`, not `report`) ────────
# GITHUB_TOKEN=github_pat_...            # push + pull-request rights on NEXT_HARNESS
# NEXT_HARNESS_PATH=../NEXT_HARNESS      # local checkout of the repo to fix
# NEXT_HARNESS_BRANCH=llm-ops/automated-fixes
# NEXT_HARNESS_BASE_BRANCH=main          # base branch PRs target
# REMEDIATE_AUTO_MERGE=1                 # opt in to merging (default: open PR only)
# REMEDIATE_MERGE_METHOD=squash          # squash | merge | rebase
# REMEDIATE_MAX_BUDGET_USD=3             # budget ceiling for the headless agent

# ── Optional: point the pipeline at a different target ─────────────────────
# HARNESS_RUNS_TABLE=harness_agent_runs  # runs table name in the MCP Postgres
# OPTIMIZATIONS_DIR=optimizations        # proactive backlog directory
